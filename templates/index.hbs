<html lang='en'>
  <head>
    <meta charset='UTF-8' />
    <meta name='viewport' content='width=device-width, initial-scale=1.0' />
    <title>Invoice</title>
    <style>
      @page { size: portrait; margin-bottom: 0; line-height: 1.5; } *, *::before, *::after {
      box-sizing: border-box; font-family: Helvetica, sans-serif; } body { font-size: 9pt;
      font-family: Helvetica, sans-serif; margin: 0; padding: 0; background-color: #fff; } .page {
      break-after: page; } .invoice { padding: 0 1rem 1rem; } .invoice-header { display: flex;
      justify-content: space-between; align-items: center; } .invoice-code { display: flex;
      justify-content: space-between; align-items: center; line-height: 1.2; } .invoice-body-1 {
      display: grid; gap: 1px; background-color: #000; padding: 1px; grid-template-columns: 3fr 1fr
      1fr; } .invoice-body { background-color: #fff; padding: 1rem; } .item1 { grid-column: 1;
      grid-row: 1 / span 6; } .item4 { grid-column: 1 / span 2; grid-row: 3; text-align: center; }
      .item5 { grid-column: 2 / span 3; grid-row: 3 / span 4;} .item8 { grid-column: 1 / span 2; }
      .buyer-details { display: flex; flex-direction: column; width: 33.35%; } .invoice-total {
      margin-top: 1rem; } .invoice-footer { margin-top: 1rem; } .bold { font-weight: bold; }
      .h2-prev { font-size: 11pt; font-weight: 700; } .margin-bottom { margin-bottom: 16px; }
      .invoice-table { width: 100%; border-collapse: collapse;} .invoice-table th, .invoice-table td
      { padding: 1px; text-align: left; border: 1px solid #ddd; } .invoice-table thead {
      background-color: #e1e8f2; } .invoice-table th { font-weight: bold; } .invoice-table td {
      padding: 4px; } .invoice-table thead th { padding: 4px; } .invoice-table tbody
      tr:nth-child(even) { background-color: #f9f9f9; } .invoice-table thead, tbody { font-size:
      12px; } .invoice-table tbody tr:hover { background-color: #f1f1f1; } .item {
      page-break-inside: avoid; } .div-title{ font-size: 11pt; line-height: 1.5;}

    </style>
  </head>
  <body>
    <div class='page'>
      <div style='min-height: 85vh;' class='page-height'>
        <div class='invoice'>
          <div class='invoice-header margin-bottom'>
            <div style='line-height: 1.04;' class='invoice-header-left'>
              <div style=' display: flex;'>
                <div>
                  <img
                    style='margin-left: -1rem;'
                    height='90px'
                    width='85px'
                    src={{pdfLogo}}
                    alt='Reliance Retail Limited'
                  />
                </div>
                <div style='margin-top: 1rem; margin-left: -0.5rem'>
                  <div style='font-size: 24px' class='h2-prev'>{{recpient.name}}</div>

                  <div style='font-size: 14px; line-height: 1.2'>
                    {{recpient.address_line_1}}
                  </div>
                  <div style='font-size: 14px; line-height: 1.2'>
                    {{recpient.address_line_2}}
                    {{recpient.address_line_3}}
                  </div>
                  <div class='bold' style='font-size: 14px; line-height: 1.2'>
                    GSTIN:
                    {{recpient.gstin}}
                  </div>
                  <br />
                  <div style='font-size: 12px; line-height: 1.2'>IRN :
                    {{irn}}
                  </div>
                  <div style='font-size: 12px; line-height: 1.2'>Acknowledgement No :
                    {{ack_no}}
                  </div>
                </div>
              </div>

            </div>
            <div style='width: 200px;' class='invoice-header-right'>
              <div style='text-align: right;'>
                <div style='font-size: 14px; line-height: 1.2;' class='bold'>TAX INVOICE</div>
                <div style='font-size: 12px; line-height: 1.2'>ORIGINAL FOR RECEIPIENT</div>
              </div>
              <img style='margin-left: 3rem;' src={{qrCodeMarkup}} alt='Reliance Retail Limited' />
            </div>
          </div>

          <div style='line-height: 1.04;' class='invoice-body-1'>
            <div style='line-height: 1.2;' class='invoice-body item1'>
              <div style='font-size: 14px; line-height: 1.2'>
                <span class='bold'> Customer Details: </span>
                <div class='bold' style='font-size: 12px;'>
                  {{supplier.name}}
                </div>
                <div class='bold' style='font-size: 12px;'>
                  GSTIN:
                  {{supplier.gstin}}
                </div>
                <br />
                <span class='bold'> Billing Address: </span>
                <div style='font-size: 12px;'>
                  {{supplier.address_line_1}}
                  {{supplier.address_line_2}}
                  {{supplier.address_line_3}}
                </div>
                <br />
                <span class='bold'> Shipping Address: </span>
                <div style='font-size: 12px;'>
                  {{ship_to.address_line_1}}
                  {{ship_to.address_line_2}}
                  {{ship_to.address_line_3}}
                </div>
              </div>
            </div>

            <div style='line-height: 1.2; font-size: 14px;' class='invoice-body item2'>
              <span class='bold'> Invoice #: </span>
              <div style='font-size: 12px'>
                {{!-- {{ack_no}} --}}
              </div>
            </div>
            <div style='line-height: 1.2; font-size: 14px;' class='invoice-body item3'>
              <span class='bold'> Date : </span>
              <div style='font-size: 12px'>
                {{document_date}}
              </div>
            </div>

            <div style='line-height: 1.2; font-size: 14px;' class='invoice-body item2'>
              <span class='bold'> Place of Supply : </span>
              <div style='font-size: 12px'>
                {{place_of_supply}}
              </div>
            </div>

            <div style='line-height: 1.2; font-size: 14px;' class='invoice-body item3'>
              <span class='bold'> Due Date : </span>
              <div style='font-size: 12px'>
                {{!-- {{document_date}} --}}
              </div>
            </div>

            <div style='line-height: 1.2; font-size: 14px;' class='invoice-body item2'>
              <span class='bold'> Eway Bill #: </span>
              <div style='font-size: 12px'>
                {{ewaybill_number}}
              </div>
            </div>

            <div style='line-height: 1.2; font-size: 14px;' class='invoice-body item3'>
              <span class='bold'> Vehicle Number : </span>
              <div style='font-size: 12px'>
                {{!-- {{ewaybill_number}} --}}
              </div>
            </div>

            <div style='line-height: 1.2; font-size: 14px;' class='invoice-body item5'>
              <span class='bold'> Dispatch From: </span>
              <div style='font-size: 12px'>{{dispatch.name}}</div>
              <div style='font-size: 12px'>
                {{dispatch.address_line_1}}
                {{dispatch.address_line_2}}
                {{dispatch.address_line_3}}
              </div>
            </div>
          </div>
        </div>

        <div class='invoice-body'>
          <table class='invoice-table'>
            <thead>
              <tr>
                <th>Sr.No.</th>
                <th>Item Description</th>
                <th>HSN Code</th>
                <th>Quantity</th>
                <th>Unit</th>
                <th>Unit Price</th>
                <th>Taxable Amount</th>
                <th><div>CGST (%)</div>
                  <div>SGST (%)</div>
                  <div>CESS (%)</div>
                </th>
                <th>Other Charges</th>
                <th>Total</th>
              </tr>
            </thead>
            <tbody>
              {{#each item_details.items}}
                <tr>
                  <td>{{@index}}</td>
                  <td>{{this.item_description}}</td>
                  <td>{{this.hsn_code}}</td>
                  <td>{{this.quantity}}</td>
                  <td>{{this.unit}}</td>
                  <td>{{this.discount}}</td>
                  <td>{{this.taxable_amount}}</td>
                  <td>{{this.gst}} + {{this.cess}} + {{this.state_cess}} </td>
                  <td>{{this.other_charges}}</td>
                  <td>{{this.total}}</td>
                </tr>
              {{/each}}
            </tbody>
          </table>

          <div
            style=' background-color: #fff; line-height: 1.04; padding-top: 0px; grid-template-columns: 1.5fr 1fr; row-gap: 0px;'
            class='invoice-body-1'
          >
            <div style='line-height: 1.2;' class='invoice-body item1'>
            </div>

            <div
              style='line-height: 1.2; border-bottom: 1px solid; padding: 0.5rem;'
              class='invoice-body item2'
            >

              <div style='display: flex; justify-content: space-between;'>
                <span class='bold'>Taxable Amount</span>
                <span style='text-align: right;' class='bold'>{{item_details.taxable_amount}}</span>
              </div>

            </div>

            <div
              style='line-height: 1.2; border-bottom: 1px solid; padding: 0.5rem;'
              class='invoice-body item2'
            >

              <div style='display: flex; justify-content: space-between;'>
                <span class='bold'>CGST</span>
                <span style='text-align: right;' class='bold'>{{item_details.cgst_amount}}</span>
              </div>

              <div style='display: flex; justify-content: space-between;'>
                <span class='bold'>SGST</span>
                <span style='text-align: right;' class='bold'>{{item_details.sgst_amount}}</span>
              </div>

              <div style='display: flex; justify-content: space-between;'>
                <span class='bold'>IGST</span>
                <span style='text-align: right;' class='bold'>{{item_details.igst_amount}}</span>
              </div>
            </div>

            <div style='line-height: 1.2; padding: 0.5rem;' class='invoice-body item2'>
              <div style='display: flex; justify-content: space-between; font-size: 16px;'>
                <span class='bold'>TOTAL</span>
                <span
                  style='text-align: right;'
                  class='bold'
                >{{item_details.total_invioce_amount}}</span>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class='invoice'>
        <div class='invoice-code'>
          <div style='text-align: left; width: 33%; font-size: 12pt;'>
            <div style='font-size: 11pt; line-height: 1.5' class='bold'>
              <div style='font-size: 12px;'>
                Generated By :{{generated_by}}
              </div>
              <div style='font-size: 12px;'>
                Print Date :{{print_date}}
              </div>
            </div>
          </div>
          <div style='text-align: center; width: 30%; font-size: 12pt;' class='bold'>
            <img style='text-align: right; width: 60%; font-size: 12pt;' src={{barcodeMarkup}} />

          </div>
          <div style='text-align: right; width: 33%; font-size: 12pt;' class='h2-prev'>
            <br />
            <br />
            <br />
            <div style='font-size: 12px; line-height: 1.5'>
              Digitally Signed by NIC-IRP
              <div style='font-size: 12px; line-height: 1.5'>
                on
                {{print_date}}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

  </body>
</html>