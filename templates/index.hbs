<html lang='en'>
	<head>
		<meta charset='UTF-8' />
		<meta name='viewport' content='width=device-width, initial-scale=1.0' />
		<title>Invoice</title>
		<style>
			@page :first { size: A4 portrait; margin-bottom: 0; line-height: 1.5; } /*
			Landscape orientation for the rest of the pages */ @page { size: A4
			landscape; margin-bottom: 2rem; } *, *::before, *::after { box-sizing:
			border-box; font-family: Helvetica, sans-serif; } body { font-size: 9pt;
			font-family: Helvetica, sans-serif; margin: 0; padding: 0;
			background-color: #fff; } .page { break-after: page; } .invoice { padding:
			0 1rem 1rem; } .invoice-header { display: flex; justify-content:
			space-between; align-items: center; } .invoice-code { display: flex;
			justify-content: space-between; align-items: center; line-height: 1.2; }
			.invoice-body-1 { display: grid; gap: 1px; background-color: #000;
			padding: 1px; grid-template-columns: 1fr 1fr; } .invoice-body {
			background-color: #fff; padding: 1rem; } .item1 { grid-column: 1;
			grid-row: 1 / span 2; } .item4 { grid-column: 1 / span 2; grid-row: 3;
			text-align: center; } .item8 { grid-column: 1 / span 2; } .buyer-details {
			display: flex; flex-direction: column; width: 33.35%; } .invoice-total {
			margin-top: 1rem; } .invoice-footer { margin-top: 1rem; } .bold {
			font-weight: bold; } .h2-prev { font-size: 11pt; font-weight: 700; }
			.margin-bottom { margin-bottom: 16px; } .invoice-table { width: 100%;
			border-collapse: collapse; } .invoice-table th, .invoice-table td {
			border: 1px solid #000; padding: 4px; text-align: left; } .invoice-table
			thead, tbody { font-size: 12px; } .invoice-table th, td { vertical-align:
			top !important; } .item { page-break-inside: avoid; } .div-title{
			font-size: 11pt; line-height: 1.5;}

		</style>
	</head>
	<body>
		<div class='page'>
			<div  class='invoice'>
				<div class='invoice-header margin-bottom'>
					<div style='line-height: 1.04;' class='invoice-header-left'>
						<div style='font-size: 16px; line-height: 1.5;' class='h2-prev'>{{generated_by}}</div>
						<div style='font-size: 24px' class='h2-prev'>{{supplier.name}}</div>
						<div style='font-size: 11pt; line-height: 1.5'>IRN :
							{{irn}}
						</div>
					</div>
					<div class='invoice-header-right'>
						<img
							{{! style=' margin-right: 75px;' }}
							{{! height='50px'
							width='61px' }}
							src={{qrCodeMarkup}}
							alt='Reliance Retail Limited'
						/>
					</div>
				</div>
				<div class='invoice-code'>
					<div style='text-align: left; width: 33%; font-size: 12pt;'>
						<div style='font-size: 11pt; line-height: 1.5'>Ack No. :
							{{ack_no}}
						</div>
					</div>
					{{!-- <div
						style='text-align: center; width: 30%; font-size: 12pt; margin-right: 65px;'
					>
						<div style='font-size: 11pt; line-height: 1.5'>Ack No. :
							{{ack_no}}</div>

					</div> --}}
					<div style='text-align: right; width: 33%; font-size: 12pt;'>
						<div style='font-size: 11pt; line-height: 1.5'>Ack Date. :
							{{ack_date}}
						</div>
					</div>
				</div>
				<div style='line-height: 1.04;' class='invoice-body-1'>
					<div style='line-height: 1.2;' class='invoice-body item1'>
						<div style='font-size: 11pt; line-height: 1.5'>
							<span class='bold'> Supply Type Code: </span>
							{{supply_type_code}}</div>
						<br /><br />
						<div style='font-size: 11pt;'>
							<span class='bold'> Place of Supply:</span>
							{{place_of_supply}}
						</div>
						<div style='font-size: 11pt;'>
							<span class='bold'>Document Type:</span>
							{{document_type}}
						</div>
					</div>
					<div style='line-height: 1.2;' class='invoice-body item2'>
						<div style='font-size: 11pt; line-height: 1.5'>
							<span class='bold'>Document No. :</span>
							{{document_number}}</div>
						<br /><br />
						<div style='font-size: 11pt;'>
							<span class='bold'>Document Date:</span>
							{{document_date}}
						</div>
					</div>
					<div class='invoice-body item3'>
						<div class='div-title'>
							IGST applicable despite Supplier and
						</div>
						<div class='div-title'>
							Recipient located in the same state : No
						</div>
					</div>
					{{!-- <div class='invoice-body item4'>
						<div
							style='line-height: 1.4; font-size: 12pt;'
							class='h2-prev margin-bottom'
						>{{site_details.name}}</div>
						<div style='line-height: 1.5;' class='bold'>Party Details :
						</div>
					</div> --}}

					{{! Party Details }}
					<div style='line-height: 1.27;' class='invoice-body item5'>
						{{! <div style='line-height: 1.5;' class='bold'>Party Details :
						</div> }}
						<div class='div-title bold'>
							Supplier:
						</div>
						<div>
							GSTIN:
							{{supplier.gstin}}
						</div>
						<div>
							{{supplier.name}}
						</div>
						<div>
							{{supplier.address_line_1}}
						</div>
						<div>
							{{supplier.address_line_2}}
							{{supplier.address_line_3}}
						</div>
						<br />
						<br />
						<br />

						<div class='div-title bold'>
							Dispatch From :
						</div>
						<div>
							{{dispatch.name}}
						</div>
						<div>
							{{dispatch.address_line_1}}
						</div>
						<div>
							{{dispatch.address_line_2}}
							{{dispatch.address_line_3}}
						</div>

					</div>
					<div style='line-height: 1.27;' class='invoice-body item5'>
						{{! <div style='line-height: 1.5;' class='bold'>Party Details :
						</div> }}
						<div class='div-title bold'>
							Recipient:
						</div>
						<div>
							GSTIN:
							{{recpient.gstin}}
						</div>
						<div>
							{{recpient.name}}
						</div>
						<div>
							{{recpient.address_line_1}}
						</div>
						<div>
							{{recpient.address_line_2}}
							{{recpient.address_line_3}}
						</div>
						<br />
						<br />

						<div class='div-title bold'>
							Ship To :
						</div>
						<div>
							GSTIN:
							{{ship_to.gstin}}
						</div>
						<div>
							{{ship_to.name}}
						</div>
						<div>
							{{ship_to.address_line_1}}
						</div>
						<div>
							{{ship_to.address_line_2}}
							{{ship_to.address_line_3}}
						</div>

					</div>

					{{!-- <div
						style='grid-column: 1 / span 2;
			text-align: center;'
					>
						<div style='background-color: #fff; display: flex'>
							<div style='width:48%' class='invoice-body item6'>
							</div>
							<div
								style=' line-height: 1.50; width:52%; padding: 0 0 1rem;'
								class='invoice-body item7'
							>
								<div style='display: flex; justify-content: space-between;'>
									<span
										style='text-align:left; font-size: 11pt; font-weight: bold; width: 125pt;'
									>Total Order Value :</span>
									<span
										style='font-size: 11pt; font-weight: bold; align-self: center;'
									>INR</span>
									<span
										style='font-size: 11pt; font-weight: bold; 
						; text-align:center;'
									>{{total_order_value}}</span>
								</div>
							</div>
						</div>
					</div>

					<div class='invoice-body'>
						<div
							style='line-height: 1.5; font-size: 12pt;'
							class='h2-prev'
						>DELIVERY DATE : {{delivery_date}} </div>
						<div style='line-height: 1.5; font-size: 10pt;'>Payment Terms : See
							Page Inside</div>
					</div>
					<div style='line-height: 1.20;' class='invoice-body'>
						<div
							style='line-height: 1.5; font-size: 12pt;'
							class='h2-prev'
						>Delivery Term : {{delivery_terms}} </div>
					</div>

					<div class='invoice-body item8'>
						<p></p>
					</div>

					<div
						style='line-height: 1.20; grid-column: 1 / span 2;
			text-align: center;'
					>
						<div style='display: flex; column-gap: 1px;'>
							<div
								style='text-align: left;'
								class='invoice-body item9 buyer-details'
							>
								<br />
								<div>Buyer : {{buyer.name}} </div><br />
								<div>Phone : {{buyer.contact.contact_number}} </div><br />
								<div>Email : {{buyer.contact.contact_email}} </div>
							</div>
							<div
								style='justify-content: space-between'
								class='invoice-body item10 buyer-details'
							>
								<div><br />
									<div>For {{site_details.name}}</div>
									<div>{{place_of_business.name}} </div>
								</div>
								<br /><br />
								<div>
									This is a computer generated document not requiring any
									signature
								</div>
							</div>
							<div
								style='justify-content: space-between'
								class='invoice-body item11 buyer-details'
							>
								<br />
								<div>SELLER&#39;S Acceptence</div>
								<div
									style='display: flex; justify-content: space-between; margin-top:25px'
								>
									<span>Signautre</span>
									<span>Title</span>
									<span>Date</span>
								</div>
							</div>
						</div>
					</div> --}}

				</div>
				{{!-- <div style='line-height: 1.43' class='invoice-footer'>
					<div class='bold' style='font-size:8pt; line-height:1.43;'>Registered
						Office :
						{{company.address.street}},
						{{company.address.street_4}}
						{{company.address.street_5}}
						{{company.address.city}},{{company.address.pincode}}.</div>
					<div class='bold' style='font-size:8pt; line-height:1.43;'>CIN No.
						{{company.cin}}.</div>
					<div class='bold' style='font-size:8pt; line-height:1.43;'>Please
						connect with &#39;rr.vigilance@ril.com&#39; or Toll-free number:
						18008903477 to report any unethical incident violating any terms
						&amp; conditions.</div>
				</div> --}}
			</div>

			{{! Inovice Table }}
			<div class='invoice-body'>
				<table class='invoice-table'>
					<thead>
						<tr>
							<th>Sr.No.</th>
							<th>
								<div>Item Description</div>
							</th>
							<th>
								<div>HSN Code</div>
							</th>
							<th>Quantity</th>
							<th>Unit</th>
							<th>Unit Price</th>
							<th>Taxable Amount</th>
							<th><div>CGST (%)</div>
								<div>SGST (%)</div>
								<div>CESS (%)</div></th>
							<th>Other Charges</th>
							<th>Total</th>
						</tr>
					</thead>
					<tbody>
						{{#each item_details.items}}
							<tr class='item'>
								<td>1</td>
								<td>{{this.item_description}}</td>
								<td>{{this.hsn_code}}</td>
								<td>{{this.quantity}}</td>
								<td>{{this.unit}}</td>
								<td>{{this.discount}}</td>
								<td>{{this.taxable_amount}}</td>
								<td>{{this.gst}} + {{this.cess}} + {{this.state_cess}} </td>
								<td>{{this.other_charges}} </td>
								<td>{{this.total}} </td>
							</tr>
						{{/each}}
					</tbody>
				</table>
			</div>

			<div class='invoice-body'>
				<table class='invoice-table'>
					<thead>
						<tr>
							<th>Taxable Amount</th>
							<th>CSGT Amount</th>
							<th>SGST Amount</th>
							<th>IGST Amount</th>
							<th>CESS Amount</th>
							<th>State Amount</th>
							<th>Discount</th>
							<th>Other Charges</th>
							<th>Round off Amt</th>
							<th>Total Inv. Amt</th>
						</tr>
					</thead>
					<tbody>
						<tr class='item'>
							<td>{{item_details.taxable_amount}}</td>
							<td>{{item_details.cgst_amount}}</td>
							<td>{{item_details.sgst_amount}}</td>
							<td>{{item_details.igst_amount}}</td>
							<td>{{item_details.cess_amount}}</td>
							<td>{{item_details.state_cess}}</td>
							<td>{{item_details.discount}}</td>
							<td>{{item_details.other_charges}}</td>
							<td>{{item_details.round_off_amount}}</td>
							<td>{{item_details.total_invioce_amount}}</td>
						</tr>
					</tbody>
				</table>

			</div>

			<div class='invoice'>
				<div class='invoice-code'>
					<div style='text-align: left; width: 33%; font-size: 12pt;'>
						<div style='font-size: 11pt; line-height: 1.5' class='bold'>
							<div style='font-size: 12px;'>
								Generated By :{{generated_by}}
							</div>
							<div style='font-size: 12px;'>
								Print Date :{{print_date}}
							</div>
						</div>
					</div>
					<div
						style='text-align: center; width: 30%; font-size: 12pt;'
						class='bold'
					>
						<img
							style='text-align: right; width: 60%; font-size: 12pt;'
							src={{barcodeMarkup}}
						/>

					</div>
					<div
						style='text-align: right; width: 33%; font-size: 12pt;'
						class='h2-prev'
					>
               <br>
               <br>
               <br>
						<div style='font-size: 12px; line-height: 1.5'>
                     Digitally Signed by NIC-IRP
						<div style='font-size: 12px; line-height: 1.5'>
                     on {{print_date}}
                  </div>
					</div>
				</div>
			</div>
		</div>

	</body>
</html>